# Production environment for 潮池. Copy to the server as /opt/chaochi/app-env (chmod 600, root only)
# and fill in the values. This template holds no secrets; never commit the filled-in file.

NODE_ENV=production
SITE_NAME=潮池
SITE_SUBTITLE=鸣潮表情图鉴
# Public origin of the site, no trailing slash
SITE_URL=https://example.com

# PostgreSQL inside the compose network
DATABASE_URL=postgres://chaochi:CHANGE_ME@db:5432/chaochi
POSTGRES_PASSWORD=CHANGE_ME
# 32+ random bytes: openssl rand -hex 32
AUTH_SECRET=
# 16+ random bytes, used to hash IPs and user agents before storage
IP_HASH_SALT=

# R2 bucket `wuwa` (S3 API)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=wuwa
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Cap Standalone. Site key is public; the secret key starts with sk- and stays on the server.
CAP_API_ENDPOINT=https://cap.anibt.net/3358fb7a52/
CAP_SITE_KEY=3358fb7a52
CAP_SECRET_KEY=

# Mail for email verification and password reset (smtp://user:pass@host:587 or smtps://...)
SMTP_URL=
MAIL_FROM=潮池 <no-reply@example.com>

# Cloudflare cache purge (token with Zone.Cache Purge only)
CF_ZONE_ID=
CF_PURGE_TOKEN=

LOG_LEVEL=info
